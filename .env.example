# ServiSync Backend Environment Variables Template
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/servisync_dev
REDIS_URL=

ACCESS_TOKEN_SECRET=your_jwt_access_secret_key_min_32_chars_long
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_min_32_chars_long
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Providers
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Client URLs & CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Four Free-Tier AI Provider Integrations ─────────────────────────────────
# Free Tier: Google AI Studio (15 RPM / 1M TPM / 1500 RPD) - https://ai.google.dev/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Free Tier: Groq Cloud developer free tier (Generous RPM / Llama models) - https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free Tier: Cerebras Cloud developer free tier (Ultra-fast inference) - https://inference-docs.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# Free Tier: Hugging Face Serverless Inference API - https://huggingface.co/docs/inference-providers/
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct
HUGGINGFACE_PROVIDER=

# AI Orchestration Governance & Fallback Controls
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_ENABLED=true
AI_ALLOW_PAID_USAGE=false
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=800
