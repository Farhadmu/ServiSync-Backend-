            "body": {
              "mode": "raw",
              "raw": "{\n  \"diagnosis\": \"Refrigerant leak in condenser coil.\",\n  \"actionTaken\": \"Repaired coil seam, vacuum tested system, and recharged R-410A refrigerant.\",\n  \"partsReplaced\": [\"Coil O-Ring\", \"R-410A Freon 2lbs\"],\n  \"laborHours\": 2.5,\n  \"laborCost\": 112.50,\n  \"materialCost\": 45.00,\n  \"recommendations\": \"Recommended annual coil cleaning.\"\n}"
