                  "exec": [
                    "if (pm.response.code === 201) {",
                    "  var res = pm.response.json();",
                    "  pm.collectionVariables.set('serviceReportId', res.data.id);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Get Service Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}/report",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
        },
        {
          "name": "Update Status to COMPLETED",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{technicianToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            }
          }
        }
      ]
    },
