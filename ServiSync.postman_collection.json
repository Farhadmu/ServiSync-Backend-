{
  "info": {
    "name": "ServiSync API",
    "description": "ServiSync Field Service Management System - Complete API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "base_url", "value": "{{baseUrl}}" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "customer_id", "value": "" },
    { "key": "technician_id", "value": "" },
    { "key": "service_request_id", "value": "" },
    { "key": "assignment_id", "value": "" },
    { "key": "work_order_id", "value": "" },
    { "key": "invoice_id", "value": "" },
    { "key": "payment_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "header": []
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@example.com\",\n  \"password\": \"Customer@123\",\n  \"name\": \"Alice Customer\",\n  \"role\": \"CUSTOMER\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@example.com\",\n  \"password\": \"Customer@123\"\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.collectionVariables.set('access_token', pm.response.json().data.accessToken);",
                    "pm.collectionVariables.set('refresh_token', pm.response.json().data.refreshToken);",
                    "pm.collectionVariables.set('customer_id', pm.response.json().data.user.id);"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/refresh-token",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Service Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/service-categories",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Create Category (Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/service-categories",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electrical\",\n  \"description\": \"Electrical repair services\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Service Requests",
      "item": [
        {
          "name": "Create Service Request (Customer)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/service-requests",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"\",\n  \"serviceTypeId\": \"\",\n  \"title\": \"AC not cooling\",\n  \"description\": \"AC running but not cooling\",\n  \"location\": \"123 Main St\",\n  \"preferredDateTime\": \"2026-09-05T10:00:00.000Z\"\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.collectionVariables.set('service_request_id', pm.response.json().data.id);"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "List My Requests (Customer)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/service-requests",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Review Request (Manager)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/service-requests/{{service_request_id}}/review",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"APPROVE\",\n  \"adminNotes\": \"Approved for assignment\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Technicians",
      "item": [
        {
          "name": "List Technicians",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/technicians",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Get Technician Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/technicians/{{technician_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Assignments",
      "item": [
        {
          "name": "Assign Technician (Manager)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/assignments",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicianId\": \"{{technician_id}}\",\n  \"scheduledStartAt\": \"2026-09-06T09:00:00.000Z\",\n  \"scheduledEndAt\": \"2026-09-06T12:00:00.000Z\"\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.collectionVariables.set('assignment_id', pm.response.json().data.id);"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Initiate Payment (Stripe)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/initiate",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": \"{{invoice_id}}\"\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.collectionVariables.set('payment_id', pm.response.json().data.paymentId);",
                    "pm.collectionVariables.set('session_id', pm.response.json().data.sessionId);"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Stripe Success Callback",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/success?session_id={{session_id}}",
            "header": []
          }
        }
      ]
    },
    {
      "name": "Users and Work Orders",
      "item": [
        { "name": "Get Me", "request": { "method": "GET", "url": "{{base_url}}/users/me", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }] } },
        { "name": "List Work Orders", "request": { "method": "GET", "url": "{{base_url}}/work-orders?page=1&limit=10", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }] } },
        { "name": "Update Work Order Status", "request": { "method": "PATCH", "url": "{{base_url}}/work-orders/{{work_order_id}}/status", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"ARRIVED\"\n}" } } },
        { "name": "Submit Service Report", "request": { "method": "PUT", "url": "{{base_url}}/service-reports/work-orders/{{work_order_id}}", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"summary\": \"Completed inspection\",\n  \"findings\": \"Unit operating normally\",\n  \"actionsTaken\": \"Cleaned filters\"\n}" } } },
        { "name": "Get Service Report", "request": { "method": "GET", "url": "{{base_url}}/service-reports/work-orders/{{work_order_id}}", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }] } },
        { "name": "List Invoices", "request": { "method": "GET", "url": "{{base_url}}/invoices?page=1&limit=10", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }] } },
        { "name": "Get Payment", "request": { "method": "GET", "url": "{{base_url}}/payments/{{payment_id}}", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }] } },
        { "name": "Submit Feedback", "request": { "method": "POST", "url": "{{base_url}}/feedback/work-orders/{{work_order_id}}/feedback", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Excellent service\"\n}" } } },
        { "name": "List Notifications", "request": { "method": "GET", "url": "{{base_url}}/notifications?unreadOnly=true", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }] } },
        { "name": "Admin Dashboard Stats", "request": { "method": "GET", "url": "{{base_url}}/admin/dashboard-stats", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }] } }
      ]
    }
  ]
}
