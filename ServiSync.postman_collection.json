    {
      "name": "13. RBAC & Security Test Cases (403 Forbidden)",
      "item": [
        {
          "name": "Customer tries to Review Request (403)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/service-requests/{{serviceRequestId}}/review",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"APPROVE\"\n}"
            }
          }
        },
        {
          "name": "Customer tries to Assign Technician (403)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/service-requests/{{serviceRequestId}}/assign",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicianId\": \"{{technicianProfileId}}\",\n  \"scheduledStartAt\": \"2026-09-10T10:00:00.000Z\",\n  \"scheduledEndAt\": \"2026-09-10T12:00:00.000Z\"\n}"
            }
          }
